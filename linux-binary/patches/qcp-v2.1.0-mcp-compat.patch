@@ -33,6 +33,28 @@
 
 static struct CurrentAssertionDisplay *ai_current_display = NULL;
 
+/* Interactive execution starts from the already parsed PSTree, so its fresh
+ * function scope must import the C parameters stored in func_info directly.
+ * Calling cpd_define_param(info->name, NULL, ...) incorrectly treats the
+ * function as a new zero-parameter declaration and rejects every function
+ * that actually has parameters. */
+static void ai_import_function_parameters(struct func_info *info,
+                                          struct environment *env) {
+  for (struct prog_var_info_list *parameter = info->param;
+       parameter != NULL; parameter = parameter->tail) {
+    if (parameter->head == NULL || parameter->head->name == NULL) {
+      failwith("Malformed existing function parameter while importing "
+               "interactive scope");
+    }
+    struct var_scope_union *binding =
+        (struct var_scope_union *)malloc(sizeof(struct var_scope_union));
+    binding->t = IS_PROG_VAR;
+    binding->d.prog_var = parameter->head;
+    hashtbl_add(&env->ephemer.ephs->cur->se.var_scope,
+                strdup(parameter->head->name), binding);
+  }
+}
+
 static void ensure_ai_current_display(void) {
   if (ai_current_display == NULL) {
     ai_current_display = CurrentAssertionDisplayCreate();
